<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/page2_1_3_2"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/papertexture_"
    android:backgroundTint="#f8e7c2"
    android:backgroundTintMode="multiply"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".Page2_1_3_2">

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <FrameLayout
        android:layout_width="412dp"
        android:layout_height="250dp">

        <ImageView
            android:id="@+id/imageView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/page2_1_3_2"/>

        <pl.droidsonroids.gif.GifImageView
            android:id="@+id/thunderGif0"
            android:layout_width="100dp"
            android:layout_height="160dp"
            android:layout_marginTop="0dp"
            android:layout_marginLeft="210dp"
            android:src="@drawable/thunder_vfx0" />

        <pl.droidsonroids.gif.GifImageView
            android:id="@+id/thunderGif1"
            android:layout_width="100dp"
            android:layout_height="150dp"
            android:layout_marginTop="0dp"
            android:layout_marginLeft="130dp"
            android:src="@drawable/thunder_vfx0" />

        <pl.droidsonroids.gif.GifImageView
            android:id="@+id/thunderGif2"
            android:layout_width="100dp"
            android:layout_height="200dp"
            android:layout_marginTop="-0dp"
            android:layout_marginLeft="16dp"
            android:src="@drawable/thunder_vfx0"/>

    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_weight="0.1"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="25dp"
        android:gravity="center"
        android:fontFamily="@font/pixelspace"
        android:textSize="22sp"
        android:text="(Watch the storm.)"
        android:textColor="@color/white"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_weight="0.3"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/tv_page2_1_3_2"
        android:fontFamily="@font/pixelgame_font"
        android:gravity="center"
        android:padding="16dp"
        android:background="#80000000"
        android:text="Rain pours. Thunder cracks.\n\nThe storm floods part of town."
        android:textColor="@color/white"
        android:textSize="23sp"
        android:layout_marginBottom="16dp"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_weight="0.5"/>

    <Button
        android:id="@+id/btnStayHelp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Help reinforce homes."
        android:textSize="10sp"
        android:textColor="@color/white"
        android:backgroundTint="@color/cardview_dark_background"        android:fontFamily="@font/quest_font"
        android:layout_marginBottom="16dp"
        android:onClick="page2_1_3_2_1"/>

    <Button
        android:id="@+id/btnLeaveTell"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:textSize="10sp"
        android:textColor="@color/white"
        android:backgroundTint="@color/cardview_dark_background"        android:fontFamily="@font/quest_font"
        android:text="Stay inside and wait it out."
        android:onClick="page2_1_3_2_2"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_weight="0.5"/>

</LinearLayout>